# Copia este archivo como backend/.env y ajusta los valores.
# backend/.env NO se versiona.

# --- Base de datos -------------------------------------------------------
# Opción 1 (local): variables por separado.
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=cambia_esta_clave
DB_NAME=matteo_masas_db
DB_PORT=5432

# Opción 2 (hosting): cadena de conexión. Si existe, tiene prioridad sobre
# DB_HOST/DB_USER/etc. Render, Neon y Railway la entregan en este formato.
# DATABASE_URL=postgresql://usuario:clave@host:5432/base?sslmode=require
#
# TLS: se activa automáticamente al usar DATABASE_URL. Para desactivarlo:
# DB_SSL=false
#
# Conexiones máximas del pool. En planes gratuitos conviene bajarlo a 5.
# DB_POOL_MAX=10

# --- Servidor ------------------------------------------------------------
PORT=3000
NODE_ENV=development

# Número de proxies delante del servidor. En Render (y cualquier hosting con
# HTTPS) debe ser 1 para que req.ip y req.protocol sean correctos.
# TRUST_PROXY=1

# --- Panel interno -------------------------------------------------------
# Obligatoria. Usa una clave larga y aleatoria; si falta, /admin queda bloqueado.
ADMIN_KEY=cambia_esta_clave_por_una_larga

# --- Webpay Plus (Transbank) ---------------------------------------------
# integration: ambiente de pruebas gratuito con credenciales públicas.
# production: requiere código de comercio y API key reales de Transbank.
WEBPAY_ENVIRONMENT=integration
# WEBPAY_COMMERCE_CODE=597055555532
# WEBPAY_API_KEY=579B532A7440BB0C9079DED94D31EA1615BACEB56610332264630D42D0A36B1C

# URL pública del sitio (HTTPS). Obligatoria para el retorno de Webpay en
# producción.
# PUBLIC_BASE_URL=https://tudominio.cl

# Minutos que se reserva el cupo mientras el cliente paga en Webpay.
WEBPAY_EXPIRA_MINUTOS=60

# Horas que se reserva el cupo mientras se verifica un abono por transferencia.
ABONO_TRANSFERENCIA_EXPIRA_HORAS=24

# --- Correo transaccional ------------------------------------------------
# Se usa para enviar el código del pedido y los avisos de estado.
# Si no se configura ningún proveedor, los correos simplemente se omiten.
#
# Opción 1: Resend (recomendado, se envía por HTTPS).
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
#
# Opción 2: SMTP (Gmail con clave de aplicación, Brevo, Mailtrap, etc.).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=tu_correo@gmail.com
# SMTP_PASS=tu_clave_de_aplicacion
#
# Remitente que verá el cliente. Debe estar autorizado en el proveedor.
EMAIL_FROM=Matteo Masas <no-reply@matteomasas.cl>

# Tarjetas de prueba del ambiente integration:
# VISA aprobada ............ 4051 8856 0044 6623  | CVV 123 | vence futuro
# AMEX aprobada ............ 3700 0000 0002 032   | CVV 1234
# Mastercard rechazada ..... 5186 0595 5959 0568  | CVV 123
# Autenticación bancaria ... RUT 11.111.111-1 / clave 123
# Detalle completo: backend/WEBPAY_PRUEBAS.md
