# Arquitectura de componentes y stack — Matteo Masas

direction: down

navegador: "Navegador" {
  style.border-radius: 8
  tienda: "Tienda pública — index.html — app.js — cart.js"
  panel: "Panel interno — admin.html — admin.js"
  seguimiento: "Seguimiento público — seguimiento.html — seguimiento.js"
  mapa: "Mapa Leaflet"
}

servidor: "Servidor — Node.js (20 a 22) — Express 5" {
  style.border-radius: 8
  estaticos: "Archivos estáticos — frontend/"
  api: "API REST — /api/productos — /api/pedidos — /api/pedidos/alertas — /api/pagos"
  middlewares: "requireAdmin — límites por IP"
  controladores: "Controladores — productos — pedidos — pagos"
  webpay: "webpay.js — Webpay Plus"
  correo: "email.js — Brevo / SendGrid / Resend / SMTP"
  notificaciones: "notificaciones.js — plantillas y auditoría"
  delivery: "delivery.js — Haversine y polígono de Padre Hurtado"
}

bd: "PostgreSQL — 8 tablas — local o Render Postgres" {shape: cylinder}
transbank: "Transbank — Webpay Plus" {style.stroke-dash: 3}
email_api: "Brevo · SendGrid · Resend — API HTTPS" {style.stroke-dash: 3}
nominatim: "Nominatim — búsqueda de direcciones" {style.stroke-dash: 3}
tiles: "Tiles de OpenStreetMap" {style.stroke-dash: 3}

navegador.tienda -> servidor.estaticos
navegador.panel -> servidor.estaticos
navegador.seguimiento -> servidor.estaticos
navegador.tienda -> servidor.api
navegador.panel -> servidor.api: "header x-admin-key"
navegador.seguimiento -> servidor.api: "consulta por código"
servidor.api -> servidor.middlewares
servidor.middlewares -> servidor.controladores
servidor.controladores -> servidor.delivery
servidor.controladores -> servidor.webpay
servidor.controladores -> servidor.notificaciones
servidor.notificaciones -> servidor.correo
servidor.correo -> email_api: "correo transaccional"
servidor.webpay -> transbank: "create — commit — refund"
servidor.controladores -> bd: "SQL parametrizado"
navegador.tienda -> navegador.mapa
navegador.mapa -> tiles
navegador.mapa -> nominatim: "geocodificación"
