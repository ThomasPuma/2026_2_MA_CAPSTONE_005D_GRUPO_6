# MER para presentación — Matteo Masas
# Versión resumida: ocho tablas con claves y campos principales.
# El MER completo (todas las columnas) está en d1_er.png y en el documento 05.

direction: right

categoria: CATEGORIA {
  shape: sql_table
  id_categoria: int {constraint: primary_key}
  nombre: varchar(100)
}

producto: PRODUCTO {
  shape: sql_table
  id_producto: int {constraint: primary_key}
  id_categoria: int {constraint: foreign_key}
  nombre: varchar(150)
  activo: boolean
}

presentacion: PRESENTACION {
  shape: sql_table
  id_presentacion: int {constraint: primary_key}
  id_producto: int {constraint: foreign_key}
  etiqueta: varchar(100)
  precio: numeric(10,2)
}

configuracion_negocio: CONFIGURACION_NEGOCIO {
  shape: sql_table
  id_configuracion: int {constraint: primary_key}
  capacidad_pedidos_por_dia: int
  dias_anticipacion_minima: int
}

pedido: PEDIDO {
  shape: sql_table
  id_pedido: int {constraint: primary_key}
  codigo: varchar(24)
  fecha_entrega: date
  metodo_pago: varchar(20)
  estado: varchar(20)
  estado_pago: varchar(20)
  total: numeric(10,2)
}

detalle_pedido: DETALLE_PEDIDO {
  shape: sql_table
  id_detalle: int {constraint: primary_key}
  id_pedido: int {constraint: foreign_key}
  id_producto: int {constraint: foreign_key}
  cantidad: int
  subtotal: numeric(10,2)
}

historial_estado_pedido: HISTORIAL_ESTADO_PEDIDO {
  shape: sql_table
  id_historial: int {constraint: primary_key}
  id_pedido: int {constraint: foreign_key}
  estado_nuevo: varchar(20)
  creado_en: timestamptz
}

notificacion_correo: NOTIFICACION_CORREO {
  shape: sql_table
  id_notificacion: int {constraint: primary_key}
  id_pedido: int {constraint: foreign_key}
  tipo: varchar(40)
  estado: varchar(20)
  creado_en: timestamptz
}

categoria.id_categoria -> producto.id_categoria: "1 a N"
producto.id_producto -> presentacion.id_producto: "1 a N"
pedido.id_pedido -> detalle_pedido.id_pedido: "1 a N"
producto.id_producto -> detalle_pedido.id_producto: "referencia histórica"
pedido.id_pedido -> historial_estado_pedido.id_pedido: "1 a N"
pedido.id_pedido -> notificacion_correo.id_pedido: "1 a N"
